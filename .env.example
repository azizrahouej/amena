# Copiez ce fichier en .env (ou définissez ces variables chez l'hébergeur). Ne publiez jamais .env.

# Clé API Anthropic : active la génération de réponses par Claude (toutes les langues, réponses longues).
# Sans clé, AMENA fonctionne en mode « extractif » (réponses construites à partir de la base, déjà en fr/ar/derja).
# Attention : avec une clé, les messages (anonymisés) sont envoyés à l'API Anthropic.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour la génération.
AMENA_MODEL=claude-opus-5-5

# Fournisseur : auto (Claude si clé, sinon Ollama s'il répond) | claude | ollama | aucun
AMENA_LLM=auto
# Adresse et modèle Ollama (modèle local), si utilisé
AMENA_OLLAMA_URL=http://localhost:11434
AMENA_OLLAMA_MODELE=llama3.2:3b

# Recherche externe encadrée (sites juridiques officiels, mots-clés seulement) : 1 pour activer.
# Nécessite une clé de l'API Brave Search (https://brave.com/search/api/).
AMENA_RECHERCHE_EXTERNE=0
BRAVE_API_KEY=

# 1 = active la recherche sémantique (télécharge ~470 Mo la première fois).
AMENA_EMBEDDINGS=0

# Nombre de passages récupérés par question.
AMENA_TOP_K=4

# Fichier de la base (comptes, avis anonymes). Dans Docker : /app/donnees/amena.db (volume).
# AMENA_BASE=data/amena.db